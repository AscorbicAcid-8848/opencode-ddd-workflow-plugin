  "contracts": {
    "request-routing": {
      "scopeId": "request-routing",
      "scale": "用户意图、仓库状态与三条互斥工作流",
      "governingQuestion": "本次请求应进入哪一条且仅哪一条工作流？",
      "consumes": ["用户原始请求", "仓库是否存在及是否已有生产行为"],
      "allowedItemKinds": ["request-intent", "route-decision", "current-topology-fact", "open-question"],
      "requiredAnyOf": [["route-decision"]],
      "evidenceRequiredKinds": ["current-topology-fact"],
      "ownedSections": ["业务主题与分析范围"],
      "soleOutput": {"kind": "route-decision", "consumers": ["refactoring-scope-convergence", "existing-system-baseline", "system-scenarios"]}
    },
    "refactoring-scope-convergence": {
      "scopeId": "refactor-scope-convergence",
      "scale": "项目级重构意图与可验收端到端业务切面",
      "governingQuestion": "宏大或模糊的重构请求，本轮应收敛到哪一个业务切面？",
      "consumes": ["已批准路由", "项目级重构目标", "真实消费者入口线索"],
      "allowedItemKinds": ["request-intent", "refactoring-seam-candidate", "refactoring-scope-decision", "business-goal", "compatibility-constraint", "evidence-gap", "open-question"],
      "requiredAnyOf": [["refactoring-seam-candidate"], ["refactoring-scope-decision"]],
      "evidenceRequiredKinds": ["refactoring-seam-candidate", "compatibility-constraint"],
      "ownedSections": ["业务主题与分析范围", "备选解释与建议", "证据与追踪"],
      "soleOutput": {"kind": "refactoring-scope-decision", "consumers": ["existing-system-baseline"]}
    },
    "existing-system-baseline": {
      "scopeId": "existing-system-baseline",
      "scale": "现有代码、接口、数据、测试、运行行为、正式 spec 与历史决策",
      "governingQuestion": "系统当前真实做什么，哪些行为和历史决定必须保留？",
      "consumes": ["已批准路由或重构切面", "仓库与运行证据", "OpenSpec 当前规格及历史 change"],
      "allowedItemKinds": ["current-behavior-fact", "current-topology-fact", "current-spec-decision", "compatibility-constraint", "evidence-gap", "open-question", "capability-status"],
      "requiredAnyOf": [["current-behavior-fact", "current-spec-decision"], ["compatibility-constraint"]],
      "evidenceRequiredKinds": ["current-behavior-fact", "current-topology-fact", "current-spec-decision", "compatibility-constraint", "capability-status"],
      "ownedSections": ["输入场景与现状事实", "证据与追踪"],
      "soleOutput": {"kind": "current-behavior-fact", "consumers": ["big-picture-eventstorm"]}
    },
    "system-scenarios": {
      "scopeId": "system-scenarios",
      "scale": "新系统的参与者目标与系统级用户旅程",
      "governingQuestion": "系统必须为哪些参与者产生什么可观察业务结果？",
      "consumes": ["已批准路由", "业务目标", "质量要求"],
      "allowedItemKinds": ["system-scenario", "business-goal", "quality-constraint", "actor", "failure", "open-question"],
      "requiredAnyOf": [["system-scenario"], ["business-goal"]],
      "evidenceRequiredKinds": [],
      "ownedSections": ["业务主题与分析范围", "输入场景与现状事实", "证据与追踪"],
      "soleOutput": {"kind": "system-scenario", "consumers": ["big-picture-eventstorm"]}
    },
    "big-picture-eventstorm": {
      "scopeId": "system-discovery",
      "scale": "整个系统或选定业务切面的端到端业务时间线",
      "governingQuestion": "业务中发生了什么，哪里出现职责、热点和边界线索？",
      "consumes": ["系统级用户场景", "现有系统时同时消费已验证现状基线"],
      "allowedItemKinds": ["system-scenario", "actor", "business-command", "domain-event", "business-policy", "read-model", "external-party", "time-trigger", "failure", "compensation", "hotspot", "responsibility-clue", "open-question", "capability-status", "current-behavior-fact"],
