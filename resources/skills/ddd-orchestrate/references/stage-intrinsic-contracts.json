{
  "schemaVersion": "ddd-stage-intrinsic-contracts/v3",
  "scopePolicies": {
    "request-routing": {"allowedMaturities": ["fact", "proposed"]},
    "refactor-scope-convergence": {"allowedMaturities": ["fact", "hypothesis", "candidate", "proposed"]},
    "existing-system-baseline": {"allowedMaturities": ["fact", "hypothesis"]},
    "system-scenarios": {"allowedMaturities": ["hypothesis", "candidate", "proposed"]},
    "system-discovery": {"allowedMaturities": ["fact", "hypothesis", "candidate", "proposed"]},
    "system-strategy": {"allowedMaturities": ["candidate", "proposed"]},
    "context-discovery": {"allowedMaturities": ["hypothesis", "candidate"]},
    "context-tactical-design": {"allowedMaturities": ["proposed"]},
    "delivery-planning": {"allowedMaturities": ["proposed"]},
    "approved-slice-implementation": {"allowedMaturities": ["fact", "implemented", "evidence"]},
    "acceptance-evidence": {"allowedMaturities": ["fact", "proposed", "verified", "evidence"]}
  },
  "preApprovalForbiddenPatterns": [
    {"id": "PREAPPROVAL-CONFIRMED-IN-SCOPE", "pattern": "已确认纳入本次(?:变更|Change|范围)"},
    {"id": "PREAPPROVAL-FINALIZED", "pattern": "(?:已经|已)(?:最终)?收敛为最终|最终确定(?:为|采用)"},
    {"id": "PREAPPROVAL-HUMAN-APPROVED", "pattern": "(?:本阶段|本里程碑|当前方案)(?:已经|已)获?人工批准"}
  ],
  "semanticGraph": {
    "relationTypes": [
      "emits",
      "returns",
      "triggers",
      "blocks",
      "governs",
      "depends-on",
      "supports",
      "rejects"
    ],
    "scopeDispositions": [
      "existing",
      "requested",
      "approved-prior",
      "candidate",
      "future"
    ],
    "flowRoles": [
      "main",
      "exception",
      "alternative",
      "supporting",
      "none"
    ],
    "evidenceReferencePrefixes": [
      "code:",
      "runtime:",
      "test:",
      "schema:",
      "openspec:",
      "git:",
      "user-input:",
      "approval:",
      "upstream:"
    ],
    "policies": {
      "existing-system-baseline": {
        "decisionPlane": "evidence",
        "commonRequiredAttributes": ["decisionPlane", "authorityRefs"],
        "kindContracts": {
          "current-behavior-fact": {
            "required": ["observationLevel", "availability", "systemBoundary", "evidenceSubject"],
            "enums": {
              "observationLevel": ["declared", "wired", "statically-reachable", "runtime-observed", "test-verified"],
              "availability": ["operational", "partial", "stub", "absent", "unknown"],
              "systemBoundary": ["internal", "external", "unknown"]
            }
          },
          "current-topology-fact": {
            "required": ["observationLevel", "availability", "systemBoundary", "evidenceSubject"],
            "enums": {
              "observationLevel": ["declared", "wired", "statically-reachable", "runtime-observed", "test-verified"],
              "availability": ["operational", "partial", "stub", "absent", "unknown"],
              "systemBoundary": ["internal", "external", "unknown"]
            }
          },
          "capability-status": {
            "required": ["capabilityId", "status", "sourceFactRefs"],
            "enums": {"status": ["existing", "target", "future"]}
          }
        }
      },
      "big-picture-eventstorm": {
        "decisionPlane": "business",
        "commonRequiredAttributes": ["decisionPlane", "scopeDisposition", "flowRole", "authorityRefs"],
        "kindContracts": {
          "business-command": {
            "required": ["intent", "businessSideEffect"],
            "enums": {"intent": ["state-change", "information-request"]}
          },
          "domain-event": {
            "required": ["businessEffect", "businessSubjectRef", "changedState"],
            "enums": {"businessEffect": ["state-transition", "policy-trigger"]}
          },
          "read-model": {
            "required": ["queryPurpose"]
          },
          "external-party": {
            "required": ["boundary", "ownership", "boundaryEvidenceRefs"],
            "enums": {
              "boundary": ["external"],
              "ownership": ["outside-current-system"]
            }
          },
          "time-trigger": {
            "required": ["timeSemantics"]
          },
          "open-question": {
            "required": ["decisionId", "state"],
            "enums": {"state": ["unresolved"]}
          },
          "capability-status": {
            "required": ["capabilityId", "status", "sourceFactRefs"],
            "enums": {"status": ["existing", "target", "future"]}
          },
          "current-behavior-fact": {
            "required": ["observationLevel", "availability", "systemBoundary", "evidenceSubject", "sourceFactRefs"],
            "enums": {
              "observationLevel": ["declared", "wired", "statically-reachable", "runtime-observed", "test-verified"],
              "availability": ["operational", "partial", "stub", "absent", "unknown"],
              "systemBoundary": ["internal", "external", "unknown"]
            }
          }
        }
      },
      "design-level-eventstorm": {
        "decisionPlane": "tactical-discovery",
        "commonRequiredAttributes": ["decisionPlane", "scopeDisposition", "flowRole", "authorityRefs"],
        "kindContracts": {
          "application-command": {
            "required": ["intent", "businessSideEffect"],
            "enums": {"intent": ["state-change", "information-request"]}
          },
          "internal-domain-event": {
            "required": ["businessEffect", "businessSubjectRef", "changedState"],
            "enums": {"businessEffect": ["state-transition", "policy-trigger"]}
          },
          "read-model": {"required": ["queryPurpose"]},
          "external-party": {
            "required": ["boundary", "ownership", "boundaryEvidenceRefs"],
            "enums": {
              "boundary": ["external"],
              "ownership": ["outside-current-system"]
            }
          },
          "time-trigger": {"required": ["timeSemantics"]},
          "open-question": {
            "required": ["decisionId", "state"],
            "enums": {"state": ["unresolved"]}
          }
        }
      },
      "strategic-impact-design": {
        "decisionPlane": "strategic",
        "commonRequiredAttributes": ["decisionPlane", "authorityRefs", "inputItemRefs"],
        "decisionKinds": ["subdomain-decision", "bounded-context-decision", "ubiquitous-language-decision", "context-relationship", "deployment-mapping", "integration-contract"],
        "decisionStatus": "proposed"
      },
      "target-strategy": {
        "decisionPlane": "strategic",
        "commonRequiredAttributes": ["decisionPlane", "authorityRefs", "inputItemRefs"],
        "decisionKinds": ["subdomain-decision", "bounded-context-decision", "ubiquitous-language-decision", "context-relationship", "deployment-mapping", "integration-contract"],
        "decisionStatus": "proposed"
      },
      "subdomain-design": {
        "decisionPlane": "strategic",
        "commonRequiredAttributes": ["decisionPlane", "authorityRefs", "inputItemRefs"],
        "decisionKinds": ["subdomain-decision"],
        "decisionStatus": "proposed"
      },
      "bounded-context-design": {
        "decisionPlane": "strategic",
        "commonRequiredAttributes": ["decisionPlane", "authorityRefs", "inputItemRefs"],
        "decisionKinds": ["bounded-context-decision", "ubiquitous-language-decision"],
        "decisionStatus": "proposed"
      },
      "context-map-design": {
        "decisionPlane": "strategic",
        "commonRequiredAttributes": ["decisionPlane", "authorityRefs", "inputItemRefs"],
        "decisionKinds": ["context-relationship", "deployment-mapping", "integration-contract"],
        "decisionStatus": "proposed"
      },
      "implementation-unit-use-cases": {
        "decisionPlane": "strategic",
        "commonRequiredAttributes": ["decisionPlane", "authorityRefs", "inputItemRefs"],
        "decisionKinds": ["implementation-unit-use-case", "integration-contract"],
        "decisionStatus": "proposed"
      },
      "tactical-design": {
        "decisionPlane": "tactical-design",
        "commonRequiredAttributes": ["decisionPlane", "authorityRefs", "inputItemRefs"],
        "decisionKinds": ["application-service-decision", "aggregate-decision", "entity-decision", "value-object-decision", "domain-service-decision", "repository-decision", "internal-domain-event", "persistence-mapping", "api-contract", "cache-strategy", "database-schema", "integration-contract"],
        "decisionStatus": "proposed"
      }
    }
  },
  "deterministicSemanticRules": {
    "big-picture-eventstorm": [
      {
        "id": "BP-TECHNICAL-SOLUTION",
        "targets": ["items", "soleOutput", "sections"],
        "excludeKinds": ["current-behavior-fact"],
        "sections": ["战略事件风暴", "异常、补偿与时间约束", "热点与边界线索", "备选解释与建议"],
        "pattern": "(?:Redis|MySQL|SETNX|ZSET|TTL\\s*=|唯一索引|分布式锁|缓存回填|存储表|缓存方案|混合方案|数据库方案|表结构|索引方案|ORM|Controller|Service|Mapper|Repository|DTO|包路径|\\.java\\b|HTTP\\s*(?:401|404|409)|返回\\s*(?:401|404|409))",
        "message": "Big Picture 只能表达业务语义和热点，具体存储、缓存、传输或代码方案必须延期到责任阶段"
      },
      {
        "id": "BP-CONTEXT-FINALIZED",
        "targets": ["items", "soleOutput", "sections"],
        "includeKinds": ["responsibility-clue"],
        "sections": ["热点与边界线索"],
        "pattern": "(?:限界)?上下文(?:\\s*[：:]|$)|BC-CAND",
        "message": "战略事件风暴只能给出职责或边界线索，不能提前命名或定稿限界上下文"
      },
      {
        "id": "BP-STRATEGIC-DECISION",
        "targets": ["soleOutput", "sections"],
        "sections": ["战略事件风暴", "热点与边界线索", "备选解释与建议"],
        "pattern": "(?:核心域|支撑域|通用域|限界上下文|微服务|部署边界)",
        "message": "子域、限界上下文和部署决定属于战略设计，不属于 Big Picture EventStorming"
      }
    ],
    "strategic-impact-design": [
      {
        "id": "STRATEGY-TACTICAL-LEAK",
        "targets": ["items", "soleOutput", "sections"],
        "sections": ["子域划分", "限界上下文", "上下文映射", "工程承载关系", "历史战略决策处理", "备选战略方案与建议"],
        "pattern": "(?:聚合根|值对象|领域服务|应用服务|Repository|Mapper|DTO|数据库表|唯一索引|缓存策略|代码路径|\\.java\\b)",
        "message": "战略设计不能提前形成聚合、服务、持久化或代码级决定"
      }
    ],
    "target-strategy": [
      {
        "id": "STRATEGY-TACTICAL-LEAK",
        "targets": ["items", "soleOutput", "sections"],
        "sections": ["子域划分", "限界上下文", "上下文映射", "工程承载关系", "历史战略决策处理", "备选战略方案与建议"],
        "pattern": "(?:聚合根|值对象|领域服务|应用服务|Repository|Mapper|DTO|数据库表|唯一索引|缓存策略|代码路径|\\.java\\b)",
        "message": "战略设计不能提前形成聚合、服务、持久化或代码级决定"
      }
    ],
    "subdomain-design": [
      {
        "id": "SUBDOMAIN-BOUNDARY-LEAK",
        "targets": ["items", "soleOutput", "sections"],
        "sections": ["子域划分", "备选战略方案与建议"],
        "pattern": "(?:聚合根|值对象|应用服务|数据库表|代码路径|\\.java\\b)",
        "message": "子域识别只回答业务能力及差异化价值，不能提前做战术或代码决定"
      }
    ],
    "bounded-context-design": [
      {
        "id": "CONTEXT-TACTICAL-LEAK",
        "targets": ["items", "soleOutput", "sections"],
        "sections": ["限界上下文", "历史战略决策处理"],
        "pattern": "(?:聚合根|值对象|应用服务|Repository|DTO|数据库表|唯一索引|代码路径|\\.java\\b)",
        "message": "限界上下文设计不能提前做战术模型、存储或代码决定"
      }
    ],
    "context-map-design": [
      {
        "id": "CONTEXT-MAP-TACTICAL-LEAK",
        "targets": ["items", "soleOutput", "sections"],
        "sections": ["上下文映射", "工程承载关系", "备选战略方案与建议"],
        "pattern": "(?:聚合根|值对象|应用服务|Repository|DTO|数据库表|唯一索引|代码路径|\\.java\\b)",
        "message": "上下文映射不能提前做战术模型、存储或代码决定"
      }
    ],
    "implementation-unit-use-cases": [
      {
        "id": "USECASE-TACTICAL-LEAK",
        "targets": ["items", "soleOutput", "sections"],
        "sections": ["实现单元用例包", "备选战略方案与建议"],
        "pattern": "(?:聚合根|值对象|Repository|Mapper|数据库表|唯一索引|缓存策略|\\.java\\b)",
        "message": "实现单元用例包只能交付业务命令、结果、失败与协作，不能提前设计战术模型"
      }
    ],
    "design-level-eventstorm": [
      {
        "id": "DL-FINAL-DESIGN",
        "targets": ["items", "soleOutput", "sections"],
        "sections": ["战术事件风暴", "失败矩阵", "业务规则与不变量候选", "模型与边界候选", "持久化与运行热点", "战略回溯检查", "备选模型方向与建议"],
        "pattern": "(?:最终聚合|聚合定稿|最终采用|定稿为|Repository|Mapper|DTO|数据库表|唯一索引|代码路径|\\.java\\b)",
        "message": "Design-Level EventStorming 只能产生模型和存储候选，最终设计属于战术设计"
      }
    ],
    "tactical-design": [
      {
        "id": "TACTICAL-CODING-LEAK",
        "targets": ["items", "soleOutput", "sections"],
        "sections": ["应用服务设计", "领域模型设计", "领域交互设计", "持久化与集成设计", "模块与分层设计", "测试设计", "设计与实现一致性清单", "领域模型一致性审查", "备选战术方案与建议"],
        "pattern": "(?:生产代码已修改|代码已经实现|代码已实现|Commit\\s*(?:SHA)?|提交\\s*SHA|测试已通过|已经部署)",
        "message": "战术设计只能形成待批准设计，代码、测试和 Git 结果属于实现阶段"
      }
    ],
    "delivery-planning": [
      {
        "id": "PLAN-CODING-LEAK",
        "targets": ["items", "soleOutput", "sections"],
        "sections": ["交付范围", "纵向交付切片", "交付追踪矩阵", "OpenSpec 变更映射", "测试与验证计划", "Git 交付计划", "风险、迁移与上线", "备选交付方案与建议"],
        "pattern": "(?:生产代码已修改|代码已经实现|代码已实现|提交\\s*SHA|测试已通过|已经部署)",
        "message": "交付规划只能定义切片和验证计划，不能声称已完成实现"
      }
    ]
  },
