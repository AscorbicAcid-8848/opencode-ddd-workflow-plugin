{
  "name": "opencode-ddd-plugin-v2",
  "version": "0.2.0",
  "description": "Lightweight OpenCode SDK plugin for DDD/OpenSpec workflows. LLM-friendly state machine + skills.",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js"
  },
  "bin": {
    "ddd-workflow-mcp": "./dist/mcp-server.js"
  },
  "files": [
    "scripts/install-opencode.mjs",
    "opencode/commands/*.md",
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "resources/**/*.json",
    "skills/**/*.md",
    "README.md",
    "docs/DDD-Workflow-Control-Panel.md"
  ],
  "scripts": {
    "install:opencode": "node scripts/install-opencode.mjs",
    "build": "tsc -p tsconfig.json",
    "install:mobile": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-mobile.ps1",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:tui": "npm run build && bun tests/tui-render.bun.mjs",
    "prepack": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@fission-ai/openspec": "1.7.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opencode-ai/plugin": "1.18.18",
    "jsonc-parser": "3.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@opentui/core": "^0.4.5",
    "@opentui/keymap": "^0.4.5",
    "@opentui/solid": "^0.4.5",
    "@types/node": "22.19.11",
    "solid-js": "^1.9.12",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.4.5",
    "@opentui/keymap": ">=0.4.5",
    "@opentui/solid": ">=0.4.5",
    "solid-js": ">=1.9.12"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/keymap": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "opencode",
    "ddd",
    "openspec",
    "eventstorming"
  ],
  "license": "UNLICENSED"
}
